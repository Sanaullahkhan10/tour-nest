# Copy this file to ".env" and fill in your own values.
# The real ".env" file is never committed to git.

# "development" on your computer, "production" on the live server.
NODE_ENV=development

# The port the server listens on.
PORT=3000

# MongoDB Atlas database user (create it with the Atlas CLI).
DATABASE_USER=
DATABASE_PASSWORD=
# Your cluster address, like cluster0.abcde.mongodb.net (no mongodb+srv:// at the front).
DATABASE_HOST=
# The name of the database inside the cluster.
DATABASE_NAME=tour-nest

# Secret used to sign login tokens. Make a long random one and never share it.
JWT_SECRET=
# How many days a login lasts.
JWT_EXPIRES_DAYS=7

# How many proxies sit in front of the app. Use 0 on your own computer.
# On a hosting service it is usually 1 (check the service's documentation).
TRUST_PROXY_HOPS=0
