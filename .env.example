# Copy this file to ".env" and fill in your own values.
# The real ".env" file is never committed to git.

# "development" on your computer, "production" on the live server.
NODE_ENV=development

# The port the server listens on.
PORT=3000

# MongoDB Atlas database user (create it with the Atlas CLI).
DATABASE_USER=
DATABASE_PASSWORD=
# Your cluster address, like cluster0.abcde.mongodb.net (no mongodb+srv:// at the front).
DATABASE_HOST=
# The name of the database inside the cluster.
DATABASE_NAME=tour-nest
