# Copy this file to ".env" and fill in your own values.
# The real ".env" file is never committed to git.

# "development" on your computer, "production" on the live server.
NODE_ENV=development

# The port the server listens on.
PORT=3000

# MongoDB Atlas database user (create it with the Atlas CLI).
DATABASE_USER=
DATABASE_PASSWORD=
# Your cluster address, like cluster0.abcde.mongodb.net (no mongodb+srv:// at the front).
DATABASE_HOST=
# The name of the database inside the cluster.
DATABASE_NAME=tour-nest

# Secret used to sign login tokens. Make a long random one and never share it.
JWT_SECRET=
# How many days a login lasts.
JWT_EXPIRES_DAYS=7

# How many proxies sit in front of the app. Use 0 on your own computer.
# On a hosting service it is usually 1 (check the service's documentation).
TRUST_PROXY_HOPS=0

# The address of the website, for the links in emails. Leave it empty on your own computer.
# On the live server it is https://tour-nest.onrender.com
SITE_URL=

# Email. Leave EMAIL_HOST empty on your own computer: emails are then written in the terminal and not sent.
# On the live server fill all five (for Brevo: host smtp-relay.brevo.com, port 587; user and password
# are the SMTP login and SMTP key from the Brevo account; EMAIL_FROM is a sender that Brevo has verified).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
