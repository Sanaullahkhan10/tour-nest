//- views/tour.pug - the page of one tour: story, route, start dates and reviews.
extends base

block head
  if mapPoints && mapPoints.length > 0
    link(rel='stylesheet' href='/vendor/leaflet/leaflet.css')

block content
  a.back-link(href='/') &larr; All tours

  section.hero(class=['hero--' + tour.difficulty, tour.imageCover ? 'hero--photo' : ''])
    if tour.imageCover
      img.hero__image(src='/img/' + tour.imageCover alt='')
    span.hero__badge= tour.difficulty
    h1.hero__title= tour.name
    p.hero__summary= tour.summary

  .detail
    .detail__main
      if tour.description
        h2 About this tour
        p.detail__text= tour.description

      if tour.images && tour.images.length > 0
        h2 Photos
        .gallery
          each image, index in tour.images
            img.gallery__image(src='/img/' + image alt=tour.name + ', photo ' + (index + 1) loading='lazy' width='600' height='400')

      if stops.length > 0
        h2 The route, day by day
        ol.stops
          each stop in stops
            li.stops__item
              span.stops__day Day #{stop.day}
              span.stops__text= stop.description

      if mapPoints && mapPoints.length > 0
        h2 The map
        #tour-map.map(data-points=JSON.stringify(mapPoints) role='region' aria-label='Map of the tour route')
          noscript The map needs JavaScript.

      h2 Reviews
      if reviews.length === 0
        p.empty No reviews yet.
      else
        each item in reviews
          article.review
            .review__top
              span.review__name= item.userName
              span.review__stars(aria-label=item.rating + ' out of 5')= stars(item.rating)
            p.review__text= item.review
            p.review__date= formatDate(item.createdAt)

      h2#write-review= myReview ? 'Your review' : 'Write a review'
      if !user
        p.empty #[a(href='/login') Log in] to write a review.
      else if user.role !== 'user'
        p.empty Only visitors with a normal user account can write reviews.
      else if !myReview && !canReview
        p.empty Only guests with a paid booking of this tour can write a review.
      else
        form#review-form.form.review-form(method='post' data-mode=(myReview ? 'update' : 'create') data-tour=tourId data-review=(myReview ? myReview._id : false))
          label.form__label(for='rating') Rating
          select#rating.form__input(name='rating' required)
            option(value='' disabled selected=(!myReview)) Choose a rating
            each n in [5, 4, 3, 2, 1]
              option(value=n selected=(myReview && myReview.rating === n)) #{n} out of 5
          label.form__label(for='review') Your review
          textarea#review.form__input(name='review' rows='5' maxlength='1000' required)= myReview ? myReview.review : ''
          p.form__message(role='alert' aria-live='polite' data-message)
          .form__actions
            button.button.form__submit(type='submit')= myReview ? 'Save changes' : 'Post review'
            if myReview
              button#review-delete.button.button--danger.form__submit(type='button') Delete my review

    aside.detail__side
      .box
        p.box__price= formatPrice(tour.price)
        p.box__per per person
        dl.facts
          dt Duration
          dd #{tour.duration} days
          dt Group size
          dd Up to #{tour.maxGroupSize} people
          dt Difficulty
          dd.facts__capital= tour.difficulty
          dt Rating
          dd
            if tour.ratingsQuantity > 0
              | #{tour.ratingsAverage} / 5 (#{tour.ratingsQuantity} reviews)
            else
              | No reviews yet
          if tour.startLocation
            dt Starts in
            dd= tour.startLocation.address
        h3.box__title Start dates
        if startDates.length > 0
          ul.dates
            each date in startDates
              li= formatDate(date)
        else
          p.box__note No upcoming dates yet.
        if startDates.length > 0
          h3.box__title Book this tour
          if user
            form#booking-form.form(method='post' data-tour=tourId)
              label.form__label(for='booking-date') Start date
              select#booking-date.form__input(name='startDate' required)
                each date in startDates
                  option(value=new Date(date).toISOString())= formatDate(date)
              label.form__label(for='booking-guests') Guests (up to #{tour.maxGroupSize})
              input#booking-guests.form__input(type='number' name='guests' min='1' max=tour.maxGroupSize value='1' required)
              label.form__label(for='booking-mobile') Mobile number
              input#booking-mobile.form__input(type='tel' name='mobile' required placeholder='03451234567' autocomplete='tel' inputmode='tel')
              p.form__message(role='alert' aria-live='polite' data-message)
              button.button.form__submit(type='submit') Continue to payment
          else
            p.box__note #[a(href='/login') Log in] to book this tour.
        if guides && guides.length > 0
          h3.box__title Your guides
          ul.guides
            each guide in guides
              li.guides__item
                img.guides__photo(src=photoUrl(guide) alt='' width='40' height='40' loading='lazy')
                span.guides__name= guide.name
                span.guides__role= guide.role === 'lead-guide' ? 'Lead guide' : 'Guide'

  script(src='/js/reviews.js' defer)
  script(src='/js/bookings.js' defer)
  if mapPoints && mapPoints.length > 0
    script(src='/vendor/leaflet/leaflet.js' defer)
    script(src='/js/map.js' defer)
