//- views/forgot-password.pug - asks for the email and sends the reset link. public/js/recover.js sends the form to the API.
extends base

block content
  section.form-card
    h1.form-card__title Forgot your password?
    p.form-card__note Give your email. If it has an account, we send you a link to choose a new password.
    form#forgot-form.form(method='post' action='/api/v1/users/forgotPassword')
      label.form__label(for='email') Email
      input#email.form__input(type='email' name='email' required autocomplete='email')
      p.form__message(role='alert' aria-live='polite' data-message)
      button.button.form__submit(type='submit') Send the link
    p.form-card__note #[a(href='/login') Back to log in]
  script(src='/js/recover.js' defer)
