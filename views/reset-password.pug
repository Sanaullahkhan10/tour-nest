//- views/reset-password.pug - the page of the link in the email: the visitor chooses a new password.
//- The token is in the address of the page. public/js/recover.js sends it to the API with the new password.
extends base

block content
  section.form-card
    h1.form-card__title Choose a new password
    form#reset-form.form(method='post' data-token=token)
      label.form__label(for='password') New password
      input#password.form__input(type='password' name='password' required minlength='8' maxlength='64' autocomplete='new-password')
      p.form__hint 8 to 64 characters.
      label.form__label(for='passwordConfirm') Confirm the new password
      input#passwordConfirm.form__input(type='password' name='passwordConfirm' required minlength='8' maxlength='64' autocomplete='new-password')
      p.form__message(role='alert' aria-live='polite' data-message)
      button.button.form__submit(type='submit') Save the new password
    p.form-card__note The link works once, for 10 minutes. #[a(href='/forgot-password') Ask for a new link]
  script(src='/js/recover.js' defer)
