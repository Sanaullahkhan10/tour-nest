//- The top bar of every page.
header.header
  a.header__logo(href='/') Tour Nest
  nav.header__nav
    a.header__link(href='/') All tours
    if user
      a.header__link(href='/my-tours') My tours
      img.header__avatar(src=photoUrl(user) alt='' width='28' height='28' data-user-photo)
      a.header__link.header__user(href='/me' data-user-name)= user.name
      button.header__button(type='button' data-logout) Log out
    else
      a.header__link(href='/login') Log in
      a.header__link.header__link--signup(href='/signup') Sign up
